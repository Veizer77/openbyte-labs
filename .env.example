# Salin ke .env.local lalu isi nilainya. Jangan commit nilai asli.
SITE_URL=http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000
# Buat secret baru minimal 32 karakter. Jangan gunakan kembali secret auth lama.
BETTER_AUTH_SECRET=
DATABASE_URI=postgres://postgres:postgres@localhost:5432/openbyte
DATABASE_URI_DIRECT=postgres://postgres:postgres@localhost:5432/openbyte

# Target operator: nama database harus diketik ulang saat menjalankan perintah.
DATABASE_MIGRATION_TARGET=openbyte
DATABASE_SEED_TARGET=openbyte
DATABASE_PREFLIGHT_TARGET=openbyte
OWNER_BOOTSTRAP_TARGET=openbyte

# Database uji terpisah (wajib berakhiran _test/-test, tidak boleh sama dengan DATABASE_URI).
TEST_DATABASE_URL=
TEST_DATABASE_TARGET=
TEST_DATABASE_WRITE_CONFIRM=

# Sinkronisasi konten dev -> database aplikasi (scripts/sync-release-content.ts).
# Hanya untuk proses terminal ini; jangan disimpan permanen di .env.
SYNC_SOURCE_URI=
SYNC_SOURCE_TARGET=
SYNC_DEST_URI=
SYNC_DEST_TARGET=

# Salin identitas admin antar-lingkungan (scripts/copy-admin-identity.ts).
# TOTP terenkripsi BETTER_AUTH_SECRET; copy hanya sah bila secret kedua sisi sama.
OWNER_COPY_SOURCE_URI=
OWNER_COPY_SOURCE_TARGET=
OWNER_COPY_DEST_URI=
OWNER_COPY_DEST_TARGET=

# Isi seluruh variabel R2 publik bersama ketika mengaktifkan storage.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_PUBLIC=
# Bucket staging/privat. WAJIB berbeda dari R2_BUCKET_PUBLIC dan tanpa akses
# publik (r2.dev dimatikan, tanpa custom domain); hanya diakses via signed URL.
R2_BUCKET_STAGING=
# Alias lama; dipakai bila R2_BUCKET_STAGING kosong.
R2_BUCKET_PRIVATE=
R2_PUBLIC_BASE_URL=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
IP_HASH_SALT=
TRUSTED_IP_HEADER=
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# Slug Sentry (bukan secret) untuk upload source map saat build produksi.
# Upload hanya berjalan bila SENTRY_AUTH_TOKEN juga terisi; build tanpa token
# (mis. CI) melewati withSentryConfig sepenuhnya.
SENTRY_ORG=
SENTRY_PROJECT=
# Token build Sentry. Hanya untuk lingkungan build (Vercel Production / CI rilis).
SENTRY_AUTH_TOKEN=
# Aktifkan hanya setelah domain, konten, dan persetujuan publikasi final.
PUBLIC_INDEXING_ENABLED=false
WA_DEFAULT_NUMBER=
TRACKING_SESSION_SECRET=

# Backup terenkripsi (workflow .github/workflows/backup.yml).
BACKUP_DATABASE_URL=
BACKUP_DATABASE_TARGET=
BACKUP_ENCRYPTION_KEY=
BACKUP_R2_ACCOUNT_ID=
BACKUP_R2_BUCKET=
BACKUP_R2_ACCESS_KEY_ID=
BACKUP_R2_SECRET_ACCESS_KEY=
# Salin ke .env.local lalu isi nilainya. Jangan commit nilai asli.
SITE_URL=http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000
# Buat secret baru minimal 32 karakter. Jangan gunakan kembali secret auth lama.
BETTER_AUTH_SECRET=
DATABASE_URI=postgres://postgres:postgres@localhost:5432/openbyte
DATABASE_URI_DIRECT=postgres://postgres:postgres@localhost:5432/openbyte

# Target operator: nama database harus diketik ulang saat menjalankan perintah.
DATABASE_MIGRATION_TARGET=openbyte
DATABASE_SEED_TARGET=openbyte
DATABASE_PREFLIGHT_TARGET=openbyte
OWNER_BOOTSTRAP_TARGET=openbyte

# Database uji terpisah (wajib berakhiran _test/-test, tidak boleh sama dengan DATABASE_URI).
TEST_DATABASE_URL=
TEST_DATABASE_TARGET=
TEST_DATABASE_WRITE_CONFIRM=

# Isi seluruh variabel R2 publik bersama ketika mengaktifkan storage.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_PUBLIC=
R2_BUCKET_STAGING=
# Alias lama; dipakai bila R2_BUCKET_STAGING kosong.
R2_BUCKET_PRIVATE=
R2_PUBLIC_BASE_URL=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
IP_HASH_SALT=
TRUSTED_IP_HEADER=
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# Aktifkan hanya setelah domain, konten, dan persetujuan publikasi final.
PUBLIC_INDEXING_ENABLED=false
WA_DEFAULT_NUMBER=
TRACKING_SESSION_SECRET=

# Backup terenkripsi (workflow .github/workflows/backup.yml).
BACKUP_DATABASE_URL=
BACKUP_DATABASE_TARGET=
BACKUP_ENCRYPTION_KEY=
BACKUP_R2_ACCOUNT_ID=
BACKUP_R2_BUCKET=
BACKUP_R2_ACCESS_KEY_ID=
BACKUP_R2_SECRET_ACCESS_KEY=
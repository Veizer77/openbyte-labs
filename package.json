{
  "name": "openbyte-labs",
  "version": "0.0.0",
  "private": true,
  "description": "OpenByte Labs: re-baseline PRD 1.5, Next.js full-stack tanpa CMS eksternal",
  "packageManager": "pnpm@12.3.4",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.config.mts",
    "test:e2e": "playwright test --config playwright.config.ts",
    "check:portability": "node scripts/check-portability.mjs",
    "check:access": "vitest run --config vitest.config.mts tests/unit/boundaries.spec.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node scripts/db-migrate.mjs",
    "db:check": "node scripts/db-check.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1158.0",
    "@aws-sdk/s3-request-presigner": "3.1158.0",
    "@tailwindcss/postcss": "4.1.16",
    "better-auth": "1.7.14",
    "dotenv": "16.4.7",
    "drizzle-orm": "0.45.4",
    "next": "16.4.3",
    "pg": "8.23.1",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "server-only": "0.0.1",
    "sharp": "0.35.5",
    "tailwindcss": "4.1.16",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "22.19.9",
    "@types/pg": "8.23.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "tsx": "4.23.15",
    "typescript": "5.7.3",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": "^22.23.4 || ^24.22.1 || >=26.0.0",
    "pnpm": "12.3.4"
  }
}

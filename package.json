{
  "name": "openbyte-labs",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:tracking": "node --conditions=react-server --import tsx tests/support/tracking-browser-smoke.ts",
    "test:cms": "node --conditions=react-server --import tsx tests/support/tracking-browser-smoke.ts --cms-only",
    "test:e2e": "playwright test",
    "test:visual": "playwright test tests/e2e/visual.spec.ts",
    "test:production": "node scripts/smoke-production.mjs",
    "db:generate": "drizzle-kit generate",
    "db:preflight": "node --conditions=react-server --import tsx scripts/db-preflight.ts",
    "db:migrate": "node --conditions=react-server --import tsx scripts/migrate.ts",
    "db:migrate:test": "node --conditions=react-server --import tsx scripts/migrate-test.ts",
    "db:status": "node --conditions=react-server --import tsx scripts/db-status.ts",
    "db:backup": "node --conditions=react-server --import tsx scripts/backup.ts",
    "db:fetch-backup": "node --conditions=react-server --import tsx scripts/fetch-backup.ts",
    "db:restore:drill": "node --conditions=react-server --import tsx scripts/restore-drill.ts",
    "db:seed:foundation": "node --conditions=react-server --import tsx scripts/seed-foundation.ts",
    "db:seed:store": "node --conditions=react-server --import tsx scripts/seed-store-dummy.ts",
    "db:sync:content": "node --conditions=react-server --import tsx scripts/sync-release-content.ts",
    "owner:create": "node --conditions=react-server --import tsx scripts/create-owner.ts",
    "prototype:import": "node scripts/import-prototype.mjs",
    "check:portability": "node scripts/check-portability.mjs",
    "owner:reset": "node --conditions=react-server --import tsx scripts/owner-reset.ts",
    "retention:run": "node --conditions=react-server --import tsx scripts/retention-run.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1158.0",
    "@aws-sdk/s3-request-presigner": "3.1158.0",
    "@hookform/resolvers": "5.2.2",
    "@sentry/nextjs": "11.10.0",
    "better-auth": "1.7.14",
    "drizzle-orm": "0.45.4",
    "next": "16.4.3",
    "postgres": "3.4.9",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.66.0",
    "server-only": "0.0.1",
    "sharp": "0.35.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@next/env": "16.4.3",
    "@playwright/test": "1.56.1",
    "@types/node": "22.19.0",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "autoprefixer": "10.4.21",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.0",
    "eslint-config-next": "16.4.3",
    "parse5": "8.0.0",
    "postcss": "8.5.32",
    "prettier": "3.9.10",
    "tailwindcss": "3.4.19",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}

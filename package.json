{
  "name": "openbyte-labs",
  "version": "1.0.0",
  "description": "OpenByte Labs public site and Payload CMS",
  "license": "MIT",
  "packageManager": "pnpm@12.3.4",
  "type": "module",
  "scripts": {
    "build": "pnpm generate:importmap && cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" next build",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation eslint .",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "typecheck": "tsc --noEmit",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "test": "pnpm run test:int",
    "test:e2e": "cross-env NODE_OPTIONS=\"--no-deprecation --import=tsx/esm\" playwright test --config=playwright.config.ts",
    "test:int": "cross-env NODE_OPTIONS=--no-deprecation vitest run --config ./vitest.config.mts",
    "migrate:create": "pnpm payload migrate:create",
    "migrate": "cross-env PAYLOAD_MIGRATE_DIRECT=1 pnpm payload migrate",
    "seed": "tsx scripts/seed.mjs",
    "owner:create": "tsx scripts/owner-create.mjs",
    "check:portability": "node scripts/check-portability.mjs",
    "check:access": "tsx scripts/check-access.mjs"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.0.2",
    "@payloadcms/db-postgres": "3.92.0",
    "@payloadcms/next": "3.92.0",
    "@payloadcms/richtext-lexical": "3.92.0",
    "@payloadcms/storage-s3": "3.92.0",
    "@payloadcms/translations": "3.92.0",
    "@payloadcms/ui": "3.92.0",
    "@sentry/nextjs": "^10.22.0",
    "@tailwindcss/postcss": "^4.1.16",
    "cross-env": "^7.0.3",
    "dotenv": "16.4.7",
    "graphql": "^16.8.1",
    "jose": "^6.1.3",
    "lucide-react": "^0.468.0",
    "next": "16.4.3",
    "payload": "3.92.0",
    "payload-totp": "3.0.6",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-hook-form": "^7.66.0",
    "sharp": "0.35.5",
    "tailwindcss": "^4.1.16",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@testing-library/react": "16.3.0",
    "@types/node": "22.19.9",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "4.5.2",
    "eslint": "^9.16.0",
    "eslint-config-next": "16.4.3",
    "jsdom": "28.0.0",
    "prettier": "^3.4.2",
    "tsx": "4.23.15",
    "typescript": "5.7.3",
    "vite-tsconfig-paths": "6.0.5",
    "vitest": "4.0.18"
  },
  "engines": {
    "node": "^22.23.4 || >=24.22.1",
    "pnpm": "^9 || ^10 || ^11 || ^12"
  }
}
